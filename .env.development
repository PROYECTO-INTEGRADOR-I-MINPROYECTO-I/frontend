# Desarrollo LOCAL (`npm run dev`). VITE_API_URL es relativo a propósito:
# el proxy de Vite (ver vite.config.ts) reenvía /api al Django local,
# así el navegador no hace cross-origin y CORS no estorba en local.
# Para el ambiente dev desplegado, ver .env.dev
#
# Advertencia: toda variable con prefijo VITE_ queda expuesta en el bundle
# público del cliente. Nunca poner claves ni secretos aquí.
VITE_API_URL=/api
VITE_ENVIRONMENT=dev
