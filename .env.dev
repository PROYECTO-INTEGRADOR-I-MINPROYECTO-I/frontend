# Ambiente dev DESPLEGADO (Render static site, rama develop).
# Distinto de .env.development, que es solo para `npm run dev` en local
# y aprovecha el proxy de Vite.
#
# Advertencia: toda variable con prefijo VITE_ queda expuesta en el bundle
# público del cliente. Nunca poner claves ni secretos aquí.
VITE_API_URL=https://planificapp-api-dev.onrender.com/api
VITE_ENVIRONMENT=dev
