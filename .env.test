# Ambiente usado por vitest (modo "test" por defecto). Los tests no hacen
# peticiones reales: stubean `fetch` con vi.stubGlobal, pero api.ts exige
# VITE_API_URL definida para no explotar al importarse.
VITE_API_URL=http://test.local/api
VITE_ENVIRONMENT=test
# Sin retardo en el handler mock (src/mocks/handler.ts) para que los tests
# no esperen los 400ms por defecto en cada petición simulada.
VITE_MOCK_DELAY=0
